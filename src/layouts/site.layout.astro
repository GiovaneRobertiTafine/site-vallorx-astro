---
// Style Imports
// import 'bootstrap/dist/css/bootstrap.min.css';
import "../styles/global.scss";

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/

// Component Imports
import Navbar from "../components/nav-bar";
import Footer from "../components/footer";
// You can import components from any supported Framework here!
// Component Script:
// You can write any JavaScript/TypeScript that you'd like here.
// It will run during the build, but never in the browser.
// All variables are available to use in the HTML template below.
let {title, pageActive, pageDescription} = Astro.props;

import ModalInscrever from '../components/modal-inscrever';
import ModalIr from '../components/modal-ir';
---

<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content={pageDescription}
        />
        <meta name="keywords" content="vallorX, vallor X, vallor x, Vallorx, Vallor X, Vallor x"/>
        <meta name="robots" content="index, follow"> 
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/assets/favicon/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/assets/favicon/favicon-16x16.png"
        />
        <link rel="manifest" href="/assets/favicon/site.webmanifest" />
        <link
            rel="mask-icon"
            href="/assets/favicon/safari-pinned-tab.svg"
            color="#fff"
        />
        <title>Vallorx | {title}</title>

        <link
            rel="icon"
            type="image/x-icon"
            href="/assets/favicon/favicon.ico"
        />

        <!-- Google tag (gtag.js) --> 
        <script is:inline async type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-7BFYN4DBBX">
        </script> 
        <script is:inline type="text/partytown"> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-7BFYN4DBBX'); 
        </script>
        <style>
            #whatsapp-button {
                z-index: 9999;
                text-decoration: none;
                display: flex;
                align-items: center;
                
                span {
                    background-color: #5f5f5f;
                    color: #fff;
                    border-radius: 5px;
                    padding: 2px 5px;
                    font-size: 12px;
                    margin-right: 10px;
                    position: relative;

                    &::after {
                        content: '';
                        position: absolute;
                        top: 50%;
                        left: 100%;
                        margin-top: -5px;
                        border-width: 5px;
                        border-style: solid;
                        border-color: transparent transparent transparent #5f5f5f;
                    }
                }

                .box-image {
                    width: 50px;
                    height: 50px;
                    border-radius: 50%;
                    border: 2px solid #069;
                    outline: none;
                    position: relative;
                    overflow: visible;

                    &::after {
                        content: "";
                        position: absolute;
                        inset: 0;
                        border-radius: inherit;
                        border: 2px solid #069;
                        opacity: 1;
                        animation: scaleOutline 2s cubic-bezier(0.25, 0, 0, 1) infinite;
                        z-index: 0;
                        pointer-events: none;
                    }

                    img {
                        position: relative;
                        z-index: 1;
                        display: block;
                        width: 100%;
                        height: 100%;
                        border-radius: inherit;
                        object-fit: cover;
                    }
                }

            }
            @keyframes scaleOutline {
                0% {
                    transform: scale(1);
                    opacity: 1;
                }
                100% {
                    transform: scale(1.4); /* Adjust scale size here */
                    opacity: 0; /* Fades out completely as it expands */
                }
            }

        </style>
    </head>

    <body>
        <main>
            <ModalInscrever client:only="react"/>
            <ModalIr/>
            <Navbar client:only="react" pageActive={pageActive} />
            <slot />

            <div class="mt-auto">
                <Footer />
            </div>
            <a class="position-fixed bottom-0 end-0 mb-5 me-3 me-md-5" href="https://wa.me/5511977696191"
                rel="noopener"
                target="_blank"
                id="whatsapp-button">
                <span>
                    Como posso te ajudar?
                </span>
                <div class="box-image">
                    <img  src="/assets/avatar.webp"
                        alt="whatsapp"
                    />
                </div>
            </a>
        </main>
        <script>
            import * as bootstrap from 'bootstrap';

            let topOffset = 0;
            const irModalElement = document.getElementById('irModal');

            const isModalOpen = (element: HTMLElement | null) =>
                element?.classList.contains('show') ?? false;

            const openInscreverModal = () => {
                const inscreverModalElement = document.getElementById('inscreverEmailModal');

                if (
                    !inscreverModalElement ||
                    isModalOpen(irModalElement) ||
                    isModalOpen(inscreverModalElement) ||
                    sessionStorage.getItem('vallorx-modal-inscreverse')
                ) return;

                bootstrap.Modal.getOrCreateInstance(inscreverModalElement).show();
                sessionStorage.setItem('vallorx-modal-inscreverse', 'active');
            };

            if (irModalElement) {
                bootstrap.Modal.getOrCreateInstance(irModalElement).show();
            }

            if (window.innerWidth <= 991) {
              
                const scrollContent = document.querySelector('main'); // store in a variable so we can reference the element in multiple locations
                scrollContent.addEventListener('scroll', () => {
                const scrolled = scrollContent.scrollTop; // reuse `scrollContent` innstead of querying the DOM again
                if (scrolled > 10) topOffset = scrolled;
                if (scrolled < 10 && topOffset > 10) {
                    openInscreverModal();
                }
                }, {passive: true});
            } else {
                window.addEventListener('mousemove', (event) => {
                    if (event.clientY > 10) topOffset = event.clientY;
                    if (event.clientY < 10 && topOffset > 10) {
                        openInscreverModal();
                    }

                });
            }
        </script>
    </body>
</html>
