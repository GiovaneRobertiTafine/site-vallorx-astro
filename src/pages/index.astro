---
import { Pages } from "../utils/pages.enum";
// Style Imports
// import 'bootstrap/dist/css/bootstrap.min.css';
import "../styles/global.scss";

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/

// Layout Imports
import SiteLayout from "../layouts/site.layout.astro";
const pageDescription = `A vallorX CONSULTORIA PRIVATE tem como MISSÃO levar aos nossos clientes e parceiros, o melhor atendimento, 
    os melhores serviços profissionais de alta performance e qualidade, bem como, o melhor preço de custo e benefício.`;
---
<SiteLayout title="Index" pageActive={Pages.HOME} pageDescription={pageDescription}>
    <style>
        .carousel-indicators {
            position: absolute;
            top: 105%;
        }

        .carousel-indicators button {
            background-color: #787473;
        }

        .carousel-indicators .active {
            background-color: #069;
        }

        .image-slide {
            height: 380px;
            width: 100%;
            object-fit: cover;

            @media (max-width: 768px) {
                height: 250px;
            }
        }

        #claudemir {
            max-width: 100%;
            height: 300px;
            object-fit: cover;

            @media (max-width: 768px) {
                width: 200px;
                height: 200px;
                object-position: top;
                margin: 0 auto;
                border-radius: 50%;
            }
        }

        #claudemir-info {
            margin-bottom: 1rem;
            @media (max-width: 768px) {
                text-align: center;
            }
        }
    </style>

    <section id="home" class="container">
        <div class="d-flex flex-column flex-lg-row">
            <div class="w-100">
                <h3 class="text-blue">Compliance Contábil e Tributário</h3>

                <div class="text-justify me-3">
                    Em um cenário cada vez mais regulado e competitivo, estar em conformidade 
                    não é apenas uma obrigação legal é um diferencial estratégico. 
                    O compliance contábil e tributário garante que sua empresa esteja alinhada 
                    às normas fiscais e contábeis, evitando riscos, multas e passivos inesperados. 
                    <br><br>
                    <strong>Por que isso importa para você?</strong>
                    <ul style="list-style-type: disc;">
                        <li><strong>Segurança jurídica:</strong> reduza riscos de autuações e processos.</li>
                        <li><strong>Eficiência financeira:</strong> otimize tributos e melhore a gestão dos recursos.</li>
                        <li><strong>Transparência e credibilidade:</strong> fortaleça a confiança de investidores, clientes e parceiros.</li>
                        <li><strong>Sustentabilidade do negócio:</strong> construa uma base sólida para crescimento contínuo.</li>
                    </ul>
                    Ao investir em compliance, você não apenas protege sua empresa, 
                    mas também abre portas para novas oportunidades de mercado, parcerias estratégicas e maior competitividade. 
                </div>
            </div>
            <div class="mt-3 mt-lg-0 w-100 position-relative">
                <div
                    id="carouselExampleIndicators"
                    class="carousel slide"
                    data-bs-ride="carousel"
                >
                    <div class="carousel-indicators">
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="0"
                            class="active"
                            aria-current="true"
                            aria-label="Slide 1"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="1"
                            aria-label="Slide 2"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="2"
                            aria-label="Slide 3"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="3"
                            aria-label="Slide 4"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="4"
                            aria-label="Slide 5"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="5"
                            aria-label="Slide 6"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="6"
                            aria-label="Slide 7"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="7"
                            aria-label="Slide 8"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="8"
                            aria-label="Slide 9"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="9"
                            aria-label="Slide 10"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="10"
                            aria-label="Slide 11"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="11"
                            aria-label="Slide 12"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="12"
                            aria-label="Slide 13"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="13"
                            aria-label="Slide 14"></button>
                        <button
                            type="button"
                            data-bs-target="#carouselExampleIndicators"
                            data-bs-slide-to="14"
                            aria-label="Slide 15"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img
                                src="/assets/bussiness.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/networking.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/advocacia.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/contabil.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/cargueiro.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/outsourcing2.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/patrimonial.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/expatriados.webp"
                                class="img-fluid d-block image-slide"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/fundo-video.jpg"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/tecnologia-informacao.webp"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/clinicas-medicas.webp"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/telecomunicacoes.webp"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/energia.webp"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/construcao-civil.webp"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                        <div class="carousel-item">
                            <img
                                src="/assets/agronegocio.webp"
                                class="img-fluid d-block image-slide" style="object-fit: contain"
                                alt="..."
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col">
                <h3 class="text-blue">Quem somos</h3>
                <p>
                    <span class="fw-bold">Missão, Visão e Valores</span> 
                    <br><br>
                    <span class="fw-bold text-blue">Missão:</span>
                    Oferecer soluções estratégicas em compliance contábil, tributário e financeiro, 
                    transformando a Reforma Tributária em vantagem competitiva. 
                    <br />
                    <span class="fw-bold text-blue">Visão:</span>
                    Transformamos desafios tributários em oportunidades de crescimento sustentável!
                    <br />
                    <span class="fw-bold text-blue">Valores:</span>
                    Ética • Inovação • Responsabilidade Social e ambiental • Excelência • Colaboração • Educação. 
                    <br />
                    <div>
                        Somos uma <strong>Contabilidade Consultiva Estratégica de Negócios</strong>, 
                        que apoia empresas na adaptação à Reforma Tributária e na gestão eficiente de riscos. 
                        <br><br>
                        Além disso, prestamos serviços especializada em <strong>recuperação de créditos tributários</strong> e 
                        <strong>BPO financeiro</strong>, com foco em setores estratégicos: 
                        <br><br>
                        <div class="d-grid text-center" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                            <div class="d-flex flex-column align-items-center">
                                <img src="assets/tecnologia-informacao.webp" 
                                alt="Tecnologia da Informação" width="150" height="150" 
                                class="rounded-circle object-fit-cover"/>
                                <span class="fw-bold">Tecnologia da Informação</span>
                            </div>
                            <div class="d-flex flex-column align-items-center">
                                <img src="assets/clinicas-medicas.webp" 
                                alt="Clínicas Médicas" width="150" height="150" 
                                class="rounded-circle object-fit-cover"/>
                                <span class="fw-bold">Clínicas Médicas</span>
                            </div>
                            <div class="d-flex flex-column align-items-center">
                                <img src="assets/telecomunicacoes.webp" 
                                alt="Serviços de Telecomunicações" width="150" height="150" 
                                class="rounded-circle object-fit-cover"/>
                                <span class="fw-bold">Serviços de Telecomunicações</span>
                            </div>
                            <div class="d-flex flex-column align-items-center">
                                <img src="assets/energia.webp" 
                                alt="Energia (geradores e distribuidores)" width="150" height="150" 
                                class="rounded-circle object-fit-cover"/>
                                <span class="fw-bold">Energia (geradores e distribuidores)</span>
                            </div>
                            <div class="d-flex flex-column align-items-center">
                                <img src="assets/construcao-civil.webp" 
                                alt="Construção civil" width="150" height="150" 
                                class="rounded-circle object-fit-cover"/>
                                <span class="fw-bold">Construção civil</span>
                            </div>
                            <div class="d-flex flex-column align-items-center">
                                <img src="assets/agronegocio.webp" 
                                alt="Agronegócio" width="150" height="150" 
                                class="rounded-circle object-fit-cover"/>
                                <span class="fw-bold">Agronegócio</span>
                            </div>
                        </div>
                    </div>
                </p>
            </div>
        </div>
        <div class="d-flex flex-column flex-lg-row mt-5 align-items-start gap-3">
            <img src="assets/claudemir.jpg" alt="claudemir" id="claudemir"/>
            <div>
                <div id="claudemir-info">
                    <h3 class="fw-bold">CLAUDEMIR PEDRO | CEO</h3>
                    <h4 class="text-blue">Empresário contábil, contador e controller.</h4>
                </div>
                <div style="line-height: 1.2;">
                    Formado em Ciências Contábeis e Controladoria. 
                    <br><br>
                    Com mais de 30 anos de atuação na área tributária, 
                    possui ampla experiência em diversos segmentos empresariais. 
                    <br><br>
                    Sua atuação abrange toda a cadeia de processos, 
                    desde a concepção do produto, formação de preços e definição da carga tributária, 
                    até a análise macro da operação e do negócio como um todo. 
                    <br><br>
                    Atualmente, seu principal desafio é preparar empresas para a Reforma Tributária, 
                    desenvolvendo estratégias que minimizem impactos no fluxo de caixa e reduzam a carga tributária, 
                    garantindo maior eficiência e sustentabilidade financeira. 
                </div>
            </div>
        </div>
    </section>
</SiteLayout>
